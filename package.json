{
	"name": "berean-study",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @berean-study/db --",
		"db:studio": "turbo run db:studio -F @berean-study/db --",
		"db:generate": "turbo run db:generate -F @berean-study/db --",
		"db:migrate": "turbo run db:migrate -F @berean-study/db --",
		"db:seed": "turbo run db:seed -F @berean-study/db --",
		"db:start": "turbo run db:start -F @berean-study/db --",
		"db:watch": "turbo run db:watch -F @berean-study/db --",
		"db:stop": "turbo run db:stop -F @berean-study/db --",
		"db:down": "turbo run db:down -F @berean-study/db --",
		"lint": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@berean-study/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@berean-study/config": "workspace:*",
		"@biomejs/biome": "^2.5.11",
		"@types/node": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "pnpm@10.32.1"
}
